# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Local caches (generated by agent/PDF tooling)
.pdf_text_cache/

# Windows "mark of the web" / Zone.Identifier alternate streams
*:Zone.Identifier

# Editor / OS temp files
*~RF*.TMP
*.swp
.DS_Store

# in-prep paper drafts must only ever be committed encrypted (tools/encrypt_papers.py)
media/papers/*.pdf

# job application sources + their build artefacts: local only, never published.
# Only the encrypted PDFs (media/papers/*.enc) are ever committed.
applications/

# full-resolution photo originals (kept locally, never served/committed)
photo-originals/

# local reference copies for citation checking (never publish)
references/
citation-audit/
