# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Local caches (generated by agent/PDF tooling)
.pdf_text_cache/

# Windows "mark of the web" / Zone.Identifier alternate streams
*:Zone.Identifier

# Editor / OS temp files
*~RF*.TMP
*.swp
.DS_Store

# in-prep paper drafts must only ever be committed encrypted (tools/encrypt_papers.py)
media/papers/*.pdf

# job application sources + their build artefacts: local only, never published.
# Only the encrypted PDFs (media/papers/*.enc) are ever committed.
# The kobold_* patterns are a safety net: building from the repo root
# (pdflatex applications/kobold/x.tex) drops the pdf/aux/log into the root.
applications/
kobold_*

# full-resolution photo originals (kept locally, never served/committed)
photo-originals/

# local reference copies for citation checking (never publish)
/references/
docs/agent-docs/citation-audit/library/

# Playwright MCP scratch output (screenshots, page snapshots)
.playwright-mcp/

# Private, provider-neutral AI continuity state and discovery adapters.
# Canonical project plans/references under docs/agent-docs remain tracked;
# only the live control overlay is local to this worktree.
docs/agent-docs/control/
# Private Agent Ledger events, state, and reports. The tracked ledger protocol,
# schemas, script, and tests remain under docs/agent-docs/agent-ledger/.
docs/agent-docs/agent-ledger/runtime/
.agents/
.claude/
.codex/
